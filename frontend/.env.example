# ─────────────────────────────────────────────────────────────────────────────
# Hunting Goals — Frontend (React + Vite) Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `frontend/.env` (local dev) and/or `frontend/.env.production`
# (production build) and fill in the values.
#
# Vite only exposes variables prefixed with VITE_* to the client bundle.
# Never put secrets in this file — everything here is shipped to the browser.

# ── Backend API ───────────────────────────────────────────────────────────────
# Base URL of the Express/Next.js API server.
# Leave empty to use same-origin + Vite dev-server proxy (recommended locally).
# Production example: https://your-backend-host.example.com
VITE_API_URL=

# ── Realtime (Socket.io) — OPTIONAL ──────────────────────────────────────────
# Socket.io is served by the SAME backend process/port as the API, so this
# defaults to VITE_API_URL and normally does NOT need to be set at all.
# Only set it if you deliberately split the socket layer onto another origin.
# Leave empty to use same-origin + Vite dev-server proxy (recommended locally).
VITE_SOCKET_URL=

# ── This app's public URL ────────────────────────────────────────────────────
# Local dev default: http://localhost:5000
VITE_APP_URL=http://localhost:5000
