# ─────────────────────────────────────────────────────────────────────────────
# Hunting Goals / TrendSpy — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment Options ──────────────────────────────────────────────────────
# Option A: Quick Start (In-Memory Database)
# Option B: Production Ready (Full Feature Set)

# ════════════════════════════════════════════════════════════════════════════
# OPTION A — QUICK START CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════

# ── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=dev_secret_2026_please_change_in_production

# ── Database ────────────────────────────────────────────────────────────────
# Leave empty — uses embedded database for testing
MONGODB_URI=
DB_NAME=trendspy_quickstart

# ── AI Services ─────────────────────────────────────────────────────────────
# No API key required — uses built-in analysis engine
GROQ_API_KEY=

# ── External Integrations ──────────────────────────────────────────────────
FB_SESSION_COOKIE=
EMAIL_USER=
EMAIL_PASS=
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=

# ── Creative Archival (Cloudinary FREE account) ─────────────────────────────
# FB CDN images expire in ~30-60 days — the archive job keeps permanent copies
# so the AI identifier and the creative history never break.
# Setup (2 min): cloudinary.com → free signup → Dashboard se "Cloud Name" copy →
# Settings → Upload → "Add upload preset" (signing mode: UNSIGNED) → naam copy.
# Dono values yahan daalo (khali rahenge to feature silently OFF rahega):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ── Security Keys ──────────────────────────────────────────────────────────
ADMIN_API_KEY=dev_admin_123456
SOCKET_INTERNAL_SECRET=socket_dev_789012

# ── Feature Controls ────────────────────────────────────────────────────────
ALERTS_ENABLED=false
TIKTOK_SANDBOX_MODE=true

# ════════════════════════════════════════════════════════════════════════════
# OPTION B — PRODUCTION CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════

# ── Authentication ──────────────────────────────────────────────────────────
# Generate using: openssl rand -base64 32
JWT_SECRET=YOUR_32_CHAR_PRODUCTION_SECRET_HERE

# ── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/trendspy
DB_NAME=trendspy_prod

# ── AI Services ─────────────────────────────────────────────────────────────
# Get your key at console.groq.com
GROQ_API_KEY=gsk_your_actual_groq_api_key_here
# Vision model for the Product Identifier (Ad Spy → "Identify Exact Product").
# REQUIRED for that feature — intentionally NO default in code.
# Groq's sole current vision model (Aug 2026 — check console.groq.com/docs/vision):
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ── Facebook Integration ────────────────────────────────────────────────────
# Required for full ad library access
# Format: "c_user=xxxxx; xs=xxxxx; fr=xxxxx"
FB_SESSION_COOKIE=your_facebook_session_cookie_here

# ── Email Notifications ────────────────────────────────────────────────────
# Gmail App Password — create at myaccount.google.com/apppasswords
EMAIL_USER=your_business_email@gmail.com
EMAIL_PASS=16_char_app_password_here

# ── WhatsApp Notifications ────────────────────────────────────────────────
# Green API credentials
GREEN_API_INSTANCE_ID=your_instance_id
GREEN_API_TOKEN=your_api_token_here

# ── Security Keys ──────────────────────────────────────────────────────────
ADMIN_API_KEY=strong_admin_key_$(openssl rand -base64 16)
SOCKET_INTERNAL_SECRET=strong_socket_secret_$(openssl rand -base64 16)

# ── Feature Controls ────────────────────────────────────────────────────────
ALERTS_ENABLED=true
TIKTOK_SANDBOX_MODE=false

# ════════════════════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS
# ════════════════════════════════════════════════════════════════════════════

# 1. Copy this entire file to your backend directory as .env.local
# 2. Choose either Option A or Option B
# 3. Comment out the unused option
# 4. Fill in all required values for your chosen option
# 5. Run: npm start

# For frontend environment:
# - Copy only the VITE_* variables to frontend/.env.local
# - All other variables are backend-only

# ════════════════════════════════════════════════════════════════════════════
# TROUBLESHOOTING
# ════════════════════════════════════════════════════════════════════════════

# If you see "MongoDB connection error" with Option A:
# - This is expected — the app automatically falls back to in-memory storage
# - Your data will reset when the server restarts

# If AI Analysis shows "fallback mode":
# - Add your GROQ_API_KEY for full AI capabilities
# - The rule-based engine works but has limited scope

# For Facebook scraping issues:
# - Ensure your FB_SESSION_COOKIE is valid and not expired
# - Format must match: "c_user=value; xs=value; ..." exactly

# Email delivery troubleshooting:
# - Verify Gmail "Less secure app access" is enabled
# - Or use your organization's SMTP server instead of Gmail

# ════════════════════════════════════════════════════════════════════════════
# RENDER DEPLOYMENT (unified single-process server)
# ════════════════════════════════════════════════════════════════════════════
# The API, Socket.io, cron jobs and Chrome-based scrapers all run in ONE
# process on ONE port. There is no separate socket server anymore.
#
# ── Server ──────────────────────────────────────────────────────────────────
# Render injects this automatically — do NOT set it yourself:
PORT=10000
#
# Frontend origin(s) allowed by CORS (comma-separated for several):
FRONTEND_URL=https://your-frontend.netlify.app
#
# ── Puppeteer / Chromium (Docker image sets these automatically) ────────────
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
#
# ── Feature flags: ALL DEFAULT TO ENABLED on Render ─────────────────────────
# The flags below were opt-in (default OFF) on the previous constrained host.
# Everything is now ON by default; set a flag to "false" only to opt OUT.
#
# CRON_ENABLED=false              → stops all 9 background cron jobs
# ALERTS_ENABLED=false            → stops the 30-min alert-check job
# AUTO_SCRAPER_ENABLED=false      → stops the in-process auto-scraper scheduler
# AUTO_CORRECT_ENABLED=false      → stops the 12-hour data integrity job
#
# ── Obsolete (remove from your environment if present) ──────────────────────
# SOCKET_INTERNAL_URL / SOCKET_INTERNAL_SECRET / NEXT_INTERNAL_URL / SOCKET_PORT
# are no longer used — Socket.io shares the API's process and port.
#
# ── Keep-alive self-ping (free-tier anti-spin-down) ─────────────────────────
# Pings <public-url>/ping every 10 minutes so the free tier never sleeps and
# cron jobs keep running. Auto-active when RENDER_EXTERNAL_URL exists.
# KEEPALIVE_URL=https://your-service.onrender.com
# KEEPALIVE_INTERVAL_MIN=10
# SELF_PING_ENABLED=false   → opt out
#
# ── Google OAuth login (required for "Continue with Google" button) ─────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Authorized redirect URI must EXACTLY match:
#   https://<your-render-service>.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
#
# ── TikTok Official API (TikTok Trends page + daily tiktokJob) ──────────────
# developers.tiktok.com → your app → Basic Information
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
# Optional: pre-minted token (auto-refresh via client credentials if omitted)
# TIKTOK_ACCESS_TOKEN=
# Keep 'true' while your TikTok app is in Sandbox tier; set 'false' after
# TikTok approves production access.
TIKTOK_SANDBOX_MODE=true
#
# ── Stripe billing (Upgrade Plan → Stripe Checkout, test mode) ─────────────
# stripe.com → Developers → API keys → Secret key (test mode = sk_test_...)
# Without this key the billing routes return 503 and the app keeps working.
STRIPE_SECRET_KEY=sk_test_your-test-secret-key
# Optional but recommended: webhook secret for authoritative plan updates.
# Local:  stripe listen --forward-to localhost:3001/api/billing/webhook
# Render: Dashboard → Developers → Webhooks → add https://<api>.onrender.com/api/billing/webhook
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
#
# ── Optional tuning (safe defaults built in) ────────────────────────────────
# JWT_EXPIRES_IN=7d
# CHROMIUM_PATH=                  # legacy override; PUPPETEER_EXECUTABLE_PATH preferred
# PROXY_LIST=                     # comma-separated http proxies for scrapers
# SEASONAL_FILTERING=true
# CONFIDENCE_THRESHOLD=60
# SUPPLIER_SCRAPER_ENABLED=false  → disables supplier discovery (admin default: ON)
