# ─── Dependencies ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ─── Environment variables (never commit real secrets) ──────────────────────
.env
.env.local
.env.production
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/.env.*.local
backend/.env
backend/.env.local
backend/.env.production
backend/.env.*.local

# ─── Build output ────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
frontend/dist/
backend/dist/
backend/.next/

# ─── Logs / temp / OS files ─────────────────────────────────────────────────
*.log
*.tmp
.tmp/
logs/
.DS_Store
Thumbs.db

# ─── Replit internal files (if any) ─────────────────────────────────────────
.replit
.replit.bak
.secrets-backup.json

# ─── Secrets / certificates ─────────────────────────────────────────────────
*.pem
*.key
*.p12

# ─── Agent / cache tooling ──────────────────────────────────────────────────
.cache/
.agents/

# ─── IDE / Editor files ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Large media / archives (to avoid GitHub limits) ────────────────────────
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.tar.gz
*.rar
*.7z
